{
  "name": "shadcn-installer",
  "version": "0.1.0",
  "description": "Enhanced tooling for shadcn/ui with improved monorepo support",
  "keywords": [
    "monorepo",
    "shadcn/ui"
  ],
  "license": "MIT",
  "author": "Steve Zhu <4130171+stevezhu@users.noreply.github.com>",
  "bin": {
    "shadcn-installer": "./bin/run.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "./bin/dev.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm run fmt:check && oxlint --type-aware --type-check",
    "lint:fix": "pnpm run fmt && oxlint --type-aware --fix",
    "test": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@oclif/core": "^4.8.0",
    "deepmerge": "^4.3.1",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.3.3",
    "ora": "^9.3.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "ts-morph": "^27.0.2",
    "typebox": "1.0.81"
  },
  "devDependencies": {
    "@stzhu/tsconfig": "^0.1.1",
    "@types/node": "^25.2.3",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "oxlint-tsgolint": "^0.11.5",
    "ts-node": "^10.9.2",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "ultracite": "7.1.5"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.1"
}
